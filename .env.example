# AI Employee System — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.

# ── Core ─────────────────────────────────────────────────────────────────────
# Safety switch: set to false only when you are ready for live operations.
DRY_RUN=true

# Absolute path to the Obsidian vault root. Defaults to current directory.
# VAULT_ROOT=/path/to/AI_Employee_Vault

# Audit log retention (days). Logs older than this are pruned.
LOG_RETENTION_DAYS=90

# ── Filesystem Watcher (Bronze) ───────────────────────────────────────────────
# Directory to monitor for new files (relative to VAULT_ROOT).
WATCH_PATH=drop_folder

# Destination folder for detected files (relative to VAULT_ROOT).
NEEDS_ACTION_PATH=Needs_Action

# Seconds a file must be unmodified before it is processed.
STABILITY_SECONDS=2.0

# ── Silver — AI (email drafting via Gemini) ───────────────────────────────────
# GEMINI_API_KEY=AIza...

# ── Silver — Gmail ────────────────────────────────────────────────────────────
# Path to OAuth2 token file (never put the token value here directly).
# GMAIL_OAUTH_TOKEN_PATH=/path/to/gmail_token.json

# ── Silver — WhatsApp ─────────────────────────────────────────────────────────
# WHATSAPP_API_TOKEN=

# ── Silver — LinkedIn ─────────────────────────────────────────────────────────
# Run 'python -m src.scripts.linkedin_auth' to generate a token.
# LINKEDIN_ACCESS_TOKEN=

# ── Gold — Odoo ───────────────────────────────────────────────────────────────
# ODOO_URL=https://your-odoo-instance.com
# ODOO_DB=your_database
# ODOO_USERNAME=admin
# ODOO_API_KEY=

# ── Gold — Social Media ───────────────────────────────────────────────────────
# FACEBOOK_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# ── Platinum — Sync ───────────────────────────────────────────────────────────
# SYNC_SSH_KEY_PATH=/path/to/sync_key
