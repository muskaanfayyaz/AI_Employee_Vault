# Odoo instance URL (no trailing slash)
ODOO_URL=https://your-instance.odoo.com

# Odoo database name
ODOO_DB=your_database

# Odoo login username (usually an email address)
ODOO_USERNAME=admin@example.com

# Odoo API key (Settings → Technical → API Keys)
# NEVER use your account password here — always create a dedicated API key.
ODOO_API_KEY=your_api_key_here

# Absolute path to the AI Employee vault root (used for approval files and logs)
# Defaults to three directories above dist/ if not set.
VAULT_PATH=/path/to/AI_Employee_Vault

# Set to "true" to enable dry-run mode — no Odoo reads or writes, no approval files created.
DRY_RUN=true
